{
  "name": "kinematic-docs",
  "private": true,
  "scripts": {
    "docs:generate": "python3 scripts/docs.py generate",
    "docs:dev": "npm run docs:generate && vitepress dev .",
    "docs:build": "npm run docs:generate && vitepress build . && python3 scripts/docs.py links",
    "docs:preview": "vitepress preview .",
    "docs:examples": "python3 scripts/docs.py examples",
    "docs:media": "python3 scripts/docs.py media",
    "docs:test": "python3 -m unittest discover -s scripts -p 'test_docs.py'"
  },
  "devDependencies": {
    "vitepress": "1.6.4"
  },
  "overrides": {
    "vite": "6.4.5"
  }
}
