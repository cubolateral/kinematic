/target

# Ignore example exports.
/output
/imgui.ini
*.log

# Ignore generated project metadata.
**/kinematic/*
!/examples/lua/*/kinematic/project.ron
!/docs/guide/projects/*/kinematic/project.ron
/examples/lua/*/.luarc.json
/docs/guide/projects/*/.luarc.json

# Documentation dependencies and build output.
/docs/node_modules
/docs/.vitepress/cache
/docs/.vitepress/.temp
/docs/.vitepress/dist
/examples/lua/*/output
/docs/guide/projects/*/output

# Python documentation tooling caches.
__pycache__/

# Documentation staging and local validation.
/docs/.cache
